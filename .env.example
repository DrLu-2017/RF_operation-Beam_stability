# DRFB 开发环境变量配置
# 复制此文件为 .env，然后根据需要修改

# Streamlit 配置
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Docker 配置
DOCKER_IMAGE_NAME=albums-streamlit-ubuntu22
DOCKER_IMAGE_TAG=latest
DOCKER_CONTAINER_NAME=albums-streamlit-dev

# 数据目录
DATA_DIR=./data

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 生产环境标志
ENVIRONMENT=development  # 或 production

# 内存配置（Docker）
MEMORY_LIMIT=4g

# CPU 配置（Docker）
CPUS_LIMIT=2
